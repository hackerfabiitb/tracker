# Copy to .env for local dev. On Vercel, set these under Project > Settings >
# Environment Variables instead (.env is never deployed).

# Upstash Redis REST credentials (Upstash console > your database > REST API)
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# Optional: key prefix, so this app can share a Redis database with another
REDIS_PREFIX="tracker:"

# Who can log in: a JSON object of email -> password, all on one line
USERS={"alice@example.com":"change-me","bob@example.com":"change-me-too"}

# Random string that signs session cookies. Changing it logs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="..."
